# .env.example
# Copy this file to .env and adjust values for your environment.
# Every variable the application reads is documented here.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the ingestion API listens on
PORT=3000

# Bind address. 0.0.0.0 = all interfaces (required inside Docker)
HOST=0.0.0.0

# Logging verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info